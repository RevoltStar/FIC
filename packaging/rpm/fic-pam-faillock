#!/bin/sh

. /etc/control.d/functions

FIC_HELPER=/opt/fic/bin/fic

new_summary 'FIC-managed pam_faillock topology for ALT local authentication'
new_help enabled 'Enable the FIC-owned pam_faillock topology'
new_help disabled 'Disable the FIC-owned pam_faillock topology'

REQUEST="$*"

case "$REQUEST" in
help|'help '*)
    control_help "${REQUEST#help}"
    ;;
list)
    control_list
    ;;
summary)
    control_summary
    ;;
status)
    exec "$FIC_HELPER" --maintenance pam-alt-faillock status
    ;;
enabled)
    exec "$FIC_HELPER" --maintenance pam-alt-faillock enable
    ;;
disabled)
    exec "$FIC_HELPER" --maintenance pam-alt-faillock disable
    ;;
*)
    printf '%s: %s\n' "${0##*/}" "Invalid mode: $REQUEST" >&2
    exit 1
    ;;
esac
