set -eu
unset FIC_SOCKET_PATH FIC_DEVICE_SOCKET_PATH
# New unit payload must be loaded before stopped-writer proofs; never start
# services until complete-install has published proven Installed.
systemctl daemon-reload
/opt/fic/bin/fic-package-infrastructure prepare-install
# Do not recursively chmod/chown shared persistent state or journal witnesses.
[ -d /opt/fic ] && [ ! -L /opt/fic ]
[ "$(stat -c '%u' /opt/fic)" = 0 ]
chown root:fic /opt/fic
chmod 2750 /opt/fic
for directory in db log notify; do
    if [ ! -e "/opt/fic/$directory" ]; then
        install -d -o root -g fic -m 2750 "/opt/fic/$directory"
    fi
    [ -d "/opt/fic/$directory" ] && [ ! -L "/opt/fic/$directory" ]
done
config_command=ensure-config
if [ ! -e /opt/fic/config ] && [ ! -L /opt/fic/config ] &&
   [ ! -e /opt/fic/lockstatus ] && [ ! -L /opt/fic/lockstatus ]; then
    config_command=ensure-config-first-install
fi
/opt/fic/bin/fic --maintenance "$config_command"
/opt/fic/bin/fic --maintenance incident-init
/opt/fic/bin/fic --maintenance initialize-journal
/opt/fic/bin/fic-dick --maintenance initialize-db
/opt/fic/bin/fic --trust-sync-platform
/opt/fic/bin/fic --maintenance incident-pam-alt attach
/opt/fic/bin/fic --maintenance pam-alt-pwhistory prepare
/opt/fic/bin/fic --maintenance complete-install
ln -sfn /opt/fic/bin/fic /bin/fic
systemd-tmpfiles --create /usr/lib/tmpfiles.d/fic.conf
systemctl daemon-reload
systemctl enable fic.service fic-device.service fic-notify.service
systemctl start fic.service fic-device.service fic-notify.service
/opt/fic/bin/fic --maintenance wait-daemon 30
/opt/fic/bin/fic-dick wait-daemon 30
echo 'FIC: installation infrastructure verified; policy apply results are available in the daemon journal'
