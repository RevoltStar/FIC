#!/bin/sh

. /etc/control.d/functions

FIC_HELPER=/opt/fic/bin/fic

new_summary 'FIC-managed pam_pwhistory topology for ALT local password changes'
new_help enabled 'Enable the FIC-owned pam_pwhistory transaction topology'
new_help disabled 'Disable the FIC-owned pam_pwhistory transaction topology'

REQUEST="$*"

case "$REQUEST" in
help|'help '*)
    control_help "${REQUEST#help}"
    ;;
list)
    control_list
    ;;
summary)
    control_summary
    ;;
status)
    exec "$FIC_HELPER" --maintenance pam-alt-pwhistory status
    ;;
enabled|disabled)
    echo 'FIC: topology changes belong to daemon policies; use fic-cli policy enable/disable IDENTITY_ACCESS (enable_authentication_lockout or enable_password_history)' >&2
    exit 1
    ;;
*)
    printf '%s: %s\n' "${0##*/}" "Invalid mode: $REQUEST" >&2
    exit 1
    ;;
esac
