[module:SYSCTL][policy:kernel_perf_event_paranoid]=Ограничение perf_event
[module:SYSCTL][policy:fs_protected_symlinks]=Защита symlink
[module:SYSCTL][policy:kernel_pid_max_limit]=Ограничение максимального числа PID
[module:SYSCTL][policy:ptrace_proc_restriction]=Ограничение ptrace
[module:SYSCTL][policy:kernel_randomize_va_space]=Рандомизация адресного пространства
[module:SYSCTL][policy:ipv4_all_accept_redirects_disable]=Запрет принятия IPv4 redirect пакетов
[module:SYSCTL][policy:ipv4_all_rp_filter_enable]=Включение IPv4 rp_filter
