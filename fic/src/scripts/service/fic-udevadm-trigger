#!/bin/sh
set -e

for candidate in /usr/bin/udevadm /usr/sbin/udevadm /sbin/udevadm /bin/udevadm; do
    if [ -x "$candidate" ]; then
        "$candidate" trigger --action=add
        "$candidate" settle
        exec /opt/fic/bin/fic-dick check-permanent
    fi
done

echo "udevadm not found" >&2
exit 1
