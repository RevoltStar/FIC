#!/usr/bin/env python3
from pathlib import Path
import sys

root = Path(sys.argv[1])
main = (root / "fic/src/main.cpp").read_text()
agent = (root / "fic-session-agent/src/main.cpp").read_text()
unit = (root / "fic/src/resources/service/fic.service.in").read_text()
device_unit = (root / "fic/src/resources/service/fic-device.service.in").read_text()
config = (root / "fic/src/resources/config/OSS.conf").read_text()
event_server = (root / "fic/src/session/SessionEventServer.cpp").read_text()
session_policy = (root / "fic/src/modules/oss/desktop_environment/SessionAwareDesktopEnvironmentPolicy.cpp").read_text()
global_reconciler = (root / "fic/src/modules/oss/desktop_environment/DesktopGlobalConfigReconciler.cpp").read_text()
gnome_system = (root / "fic/src/modules/oss/desktop_environment/backends/GnomeSystemBackend.cpp").read_text()
gnome_system_header = (root / "fic/src/modules/oss/desktop_environment/backends/GnomeSystemBackend.h").read_text()
fly_system = (root / "fic/src/modules/oss/desktop_environment/backends/FlySystemBackend.cpp").read_text()
fly_system_header = (root / "fic/src/modules/oss/desktop_environment/backends/FlySystemBackend.h").read_text()
fly_session = (root / "fic/src/modules/oss/desktop_environment/backends/FlyBackend.cpp").read_text()
xfce_session = (root / "fic/src/modules/oss/desktop_environment/backends/XfceBackend.cpp").read_text()
xfce_handler = (root / "fic/src/modules/oss/desktop_environment/policies/XfceScreenLockTimeoutHandler.h").read_text()
kde_backend = (root / "fic/src/modules/oss/desktop_environment/backends/KdeBackend.cpp").read_text()
kde_resolver = (root / "fic/src/modules/oss/desktop_environment/backends/KdeScreenLockerRuntimeContextResolver.cpp").read_text()
session_executor = (root / "fic/src/session/SessionCommandExecutor.cpp").read_text()
screenlock = (root / "fic/src/modules/oss/desktop_environment/policies/OSS_screenlock_timeout.cpp").read_text()
screenlock_header = (root / "fic/src/modules/oss/desktop_environment/policies/OSS_screenlock_timeout.h").read_text()
media_policy = (root / "fic/src/modules/oss/desktop_environment/policies/OSS_disable_kde_lock_screen_media_controls.cpp").read_text()
gnome_handler_header = (root / "fic/src/modules/oss/desktop_environment/policies/GnomeScreenLockTimeoutHandler.h").read_text()
ru_lang = (root / "fic/src/resources/lang/ru.lang").read_text()
en_lang = (root / "fic/src/resources/lang/en.lang").read_text()

assert "Type=notify" in unit
assert "NotifyAccess=main" in unit
assert "TimeoutStartSec=600s" in unit
assert "Type=notify" not in device_unit
assert "After=fic.service" in device_unit and "Requires=fic.service" in device_unit
assert "fic-device.service" not in unit
assert main.index("STATUS=Applying startup policies") < main.index("STATUS=Creating administrative socket")
assert main.index("STATUS=Creating administrative socket") < main.index("STATUS=Creating session event socket")
assert main.index("STATUS=Creating session event socket") < main.index("READY=1")
event_startup = main[main.index("const fic::ipc::AdminSocketResult eventSocketResult"):
                     main.index("READY=1", main.index("const fic::ipc::AdminSocketResult eventSocketResult"))]
assert "eventSocketResult.fileDescriptor < 0" in event_startup
assert "return 1" in event_startup
assert "ProductionSessionEvents" in main
assert "PolicyCapability::SessionAware" in main
assert "PolicyCapability::SessionInventoryCompliance" in main
worker = main[main.index("void reconcile_session_ready("):
              main.index("} // namespace", main.index("void reconcile_session_ready("))]
assert worker.index("inventory.currentSessions") < worker.index("PolicyCapability::SessionAware")
assert "run_daemon_apply_all_pass" not in worker
assert "MandatoryGlobalRuntimeWarning" in worker and "logLevel::WARN" in worker
unknown_dispatch = worker[worker.index("DesktopEnvironmentKind::Unknown"):
                          worker.index("PolicyCapability::SessionAware")]
assert "return;" in unknown_dispatch
assert "readPacketWithTimeout" in event_server
assert "POLLIN" in event_server and "POLLERR" in event_server and "POLLHUP" in event_server
assert "EAGAIN" in event_server and "EWOULDBLOCK" in event_server and "EINTR" in event_server
assert "ClientPayloadTimeoutMilliseconds" in event_server
for obsolete in ("ensureGlobalState", "applyGlobalValue",
                 "applyGlobalProtection", "verifyGlobalState"):
    assert obsolete not in session_policy
targeted = main[main.index("void reconcile_session_ready("):
                main.index("} // namespace", main.index("void reconcile_session_ready("))]
assert targeted.index("desktopGlobalConfig.reconcile") < targeted.index("reconcileSession(")
assert "globalReport.resultFor(owner, session.desktop)" in targeted
assert "globalEnforcementVerified" not in targeted
assert '"phase", "desktop_global_configuration"' in targeted
assert "DesktopGlobalConfigReconciler desktopGlobalConfig" in main
assert "std::make_shared<GnomeSystemBackend>(executables)" in main
assert "std::make_shared<FlySystemBackend>()" in main
assert "{gnomeSystemBackend, flySystemBackend}" in main
assert main.count("desktopGlobalConfig.reconcile") >= 3
assert "install_desktop_global_report" in main
assert "latestGlobalReport.successfulForPolicy" in main
assert "latestGlobalReport.successfulForModule" in main
assert "PolicyCapability::GlobalDesktopConfiguration" in global_reconciler
assert "DesktopGlobalReconcileReport" in global_reconciler
assert "report.backends" in global_reconciler
assert "report.policies" in global_reconciler
assert "MandatoryGlobal policy has no global requirement coverage" in global_reconciler
assert "if (!policy->isEnabled()) continue" in global_reconciler
assert "ensureManagedSettings" in global_reconciler
assert "verifyManagedSettings" in global_reconciler
assert "if (desired.empty()) continue" in global_reconciler
assert "replaceManagedState" not in global_reconciler
assert "bool DesktopGlobalConfigReconciler::reconcile" not in global_reconciler
assert "backend->desktop() != contribution.desktop" in global_reconciler
assert "global desktop contribution/backend desktop mismatch" in global_reconciler
assert "backend->desktop() == DesktopEnvironmentKind::Unknown" in global_reconciler
assert "duplicate desktop system backend" in global_reconciler
backend_header = (root / "fic/src/modules/oss/desktop_environment/DesktopGlobalConfigReconciler.h").read_text()
assert "virtual DesktopEnvironmentKind desktop() const = 0;" in backend_header
assert "virtual std::string backendName() const = 0;" in backend_header
assert "class GnomeSystemBackend final : public DesktopSystemBackend" in gnome_system_header
assert "class FlySystemBackend final : public DesktopSystemBackend" in fly_system_header
assert "return DesktopEnvironmentKind::Gnome" in gnome_system
assert 'return "gnome"' in gnome_system
assert "VerifiedProcessExecutor::execute" in gnome_system
assert "return DesktopEnvironmentKind::Fly" in fly_system
assert 'return "fly"' in fly_system
assert "/usr/share/fly-wm/theme.master/themerc" in fly_system_header
for required in ("openat", "O_NOFOLLOW", "fstat", "fstatat", "renameat",
                 "fsync", "S_IWGRP", "S_IWOTH", "S_IROTH"):
    assert required in fly_system
for forbidden in ("std::ifstream", "std::ofstream", "current.themerc",
                  "getpwuid", "system(", "popen(", "/bin/sh"):
    assert forbidden not in fly_system
for forbidden in ("current.themerc", "std::ifstream", "std::ofstream",
                  "getpwuid"):
    assert forbidden not in fly_session
assert "FLYWM_UPDATE_VAL" in fly_session
assert "qt6-declarative-devel" in (
    root / "packaging/rpm/Dockerfile").read_text()
for forbidden in ("system(", "popen(", "/bin/sh", "~/.config/dconf",
                  "replaceManagedState", "removeManaged"):
    assert forbidden not in gnome_system
assert 'std::string keyfileName = "99-fic.conf"' in gnome_system_header
# GNOME screenlock_timeout обязан охватывать четвёртый ключ: без
# disable-lock-screen=false GNOME Shell может вообще не блокировать экран.
assert "/org/gnome/desktop/lockdown/disable-lock-screen" in gnome_system
assert "org.gnome.desktop.lockdown" in gnome_system
assert '"/org/gnome/desktop/lockdown/disable-lock-screen", "false")' in screenlock
contributions = screenlock[
    screenlock.index("bool OSS_screenlock_timeout::globalDesktopPolicyContributions"):
    screenlock.index("bool OSS_screenlock_timeout::relevantTo")
]
assert '"kde"' not in contributions
assert '"xfce"' not in contributions
assert '"kscreenlockerrc/Daemon/' not in contributions
assert '"fly"' in contributions
assert '"themerc/Variables/ScreenSaverDelay"' in contributions
assert '"themerc/Variables/ScreenSaver",' not in contributions
assert '"themerc/Variables/ScreenSaverDBUS",' not in contributions
assert "desktop == DesktopEnvironmentKind::Kde" in screenlock
assert "GetNameOwner" in kde_resolver
assert "GetConnectionUnixProcessID" in kde_resolver
assert "GetConnectionUnixUser" in kde_resolver
assert ".st_uid" not in kde_resolver
assert '"HOME", "XDG_CONFIG_HOME", "XDG_CONFIG_DIRS", "KDE_SKIP_KDERC"' in kde_resolver
assert "LD_PRELOAD" not in kde_resolver and '"PATH"' not in kde_resolver
assert "--address=unix:path=/run/user/" in kde_resolver
assert "sameUidKdeSessionCount != 1" in kde_resolver
assert "runtimeContext_->uniqueBusOwner" in kde_backend
assert "runtimeContext_->kconfigEnvironment" in kde_backend
assert "executeWithKdeConfigEnvironment" in kde_backend
assert '"PATH", "/usr/local/bin:/usr/bin:/bin"' in session_executor
assert "showMediaControls" in media_policy
assert "EnforcementMode::SessionOnly" in media_policy
assert "session.sameUidKdeSessionCount" in media_policy
assert "backend.validateRuntimeContext" in media_policy
fic_source = "\n".join(
    path.read_text(errors="ignore")
    for path in (root / "fic").rglob("*") if path.is_file()
)
for obsolete in ("KdeSystemBackend", "fic-kconfig-verifier",
                 "FIC_BUILD_KCONFIG_VERIFIER", "KF5::ConfigCore",
                 "KF6::ConfigCore"):
    assert obsolete not in fic_source
assert "org.gnome.desktop.lockdown" in gnome_handler_header
assert "disable-lock-screen" in gnome_handler_header
# dconf profile parser поддерживает file-db/whitespace/inline comments и
# сохраняет merge-only/DISABLE semantics.
assert "file-db" in gnome_system
assert "if (required.empty()) { error.clear(); return true; }" in gnome_system
assert "duplicate system-db:fic" in gnome_system
assert "PolicyCapability::GlobalDesktopConfiguration" in screenlock_header
assert "PolicyCapability::SessionAware" in screenlock_header
mode_for = screenlock[
    screenlock.index("EnforcementMode OSS_screenlock_timeout::modeFor"):
    screenlock.index("bool OSS_screenlock_timeout::reconcileControlledSession")
]
mandatory_branch = mode_for[:mode_for.index(
    "return EnforcementMode::MandatoryGlobal")]
assert "desktop == DesktopEnvironmentKind::Gnome" in mandatory_branch
assert "desktop == DesktopEnvironmentKind::Fly" in mandatory_branch
assert "DesktopEnvironmentKind::Kde" not in mandatory_branch
session_branch = mode_for[mode_for.index(
    "return EnforcementMode::MandatoryGlobal"):]
assert "DesktopEnvironmentKind::Kde" in session_branch
assert "DesktopEnvironmentKind::Xfce" in session_branch
assert "DesktopEnvironmentKind::Fly" not in session_branch
assert "return EnforcementMode::SessionOnly" in session_branch
assert "XfceSystemBackend" not in main
assert "xfce4-screensaver-command" in xfce_session
assert '{"--query"}' in xfce_session
for forbidden in ("pgrep", "pidof", "/proc/", "XfceSystemBackend"):
    assert forbidden not in xfce_session
assert '"/saver/fullscreen-inhibit", "bool", "false"' in xfce_handler
for obsolete in ("ensureGlobalState", "applyGlobalValue",
                 "applyGlobalProtection", "verifyGlobalState"):
    assert obsolete not in screenlock
normal_apply = session_policy[session_policy.index(
    "bool SessionAwareDesktopEnvironmentPolicy::apply()") :]
insert = normal_apply.index("globallyEnforced.insert(desktop)")
assert "result->second.verified" in normal_apply[:insert]
payload = agent[agent.index("const std::string request = nlohmann::json{"):
                agent.index(".dump();", agent.index("const std::string request = nlohmann::json{"))]
assert '"event", "session_ready"' in payload
assert '"session_id", sessionId' in payload
for forbidden in ('"pid"', '"desktop"', '"policy"', '"value"'):
    assert forbidden not in payload
assert "std::thread readinessNotifier" in agent
assert "controlled_desktop_environments.value=[]" in config
assert "absence_of_uncontrolled_desktop_environments.status=DISABLE" in config
for localization in (ru_lang, en_lang):
    for policy in ("screenlock_timeout", "disable_kde_lock_screen_media_controls"):
        description = next(
            line for line in localization.splitlines()
            if line.startswith(f"[module:OSS][policy:{policy}][description]=")
        )
        assert "controlled" in description.lower() or "контролируем" in description.lower()
        assert "cannot be identified" in description.lower() or "не удалось определить" in description.lower()
        assert "absence_of_uncontrolled" not in description
for profile in (root / "fic/src/platform/profiles").glob("*.cpp"):
    assert "controlled_desktop_environments" not in profile.read_text()
print("desktop environment architecture static checks: OK")
