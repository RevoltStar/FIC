ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}
ENV container=docker DEBIAN_FRONTEND=noninteractive
ARG OPENSSH_VERSION
ARG SYSTEMD_VERSION
RUN test -n "$OPENSSH_VERSION" && test -n "$SYSTEMD_VERSION" && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config libssl-dev nlohmann-json3-dev python3 \
    "systemd=$SYSTEMD_VERSION" "libsystemd-dev=$SYSTEMD_VERSION" dbus \
    "openssh-server=$OPENSSH_VERSION" iproute2 util-linux && \
    rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
