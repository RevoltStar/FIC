# Rebuildable compiler/systemd base without SSH or SSSD. Research only.
ARG BASE_IMAGE=debian:12
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive container=docker
RUN if test -f /etc/altlinux-release; then \
      mkdir -p /var/cache/apt/archives/partial; apt-get update; \
      apt-get install -y gcc-c++ glibc-devel make cmake ctest pkg-config \
        openssl-devel libsystemd-devel nlohmann-json-devel python3 systemd dbus util-linux iproute2; \
    else \
      apt-get update && apt-get install -y --no-install-recommends build-essential \
        cmake pkg-config libssl-dev libsystemd-dev nlohmann-json3-dev python3 systemd-sysv dbus util-linux iproute2; \
    fi
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
